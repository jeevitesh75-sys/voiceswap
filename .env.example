# --- Engine: how the voice is changed ---
# basic     = free, no GPU, moves pitch and tone only (default)
# http      = your own converter server (see /converter) - real AI voice conversion
# replicate = a cloud GPU API (needs a Replicate account and billing) - untested
VC_ENGINE=basic

# for VC_ENGINE=http
CONVERTER_URL=
CONVERTER_KEY=
CONVERTER_STEPS=25

# for VC_ENGINE=replicate (open the model page > API tab and copy the two audio input names)
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
REPLICATE_FIELD_SOURCE=source_audio
REPLICATE_FIELD_TARGET=target_audio

# --- Limits (all optional) ---
MAX_SECONDS=120        # longest audio that will be converted
MAX_UPLOAD_MB=25
MAX_VOICES=10          # saved voices per person
PER_DAY=0              # conversions per person per day, 0 = no limit
RESULT_HOURS=24        # results are deleted after this
PRESETS_ALWAYS=0       # set 1 to show the fun voices (deep, child, robot) with GPU engines too
DATA_DIR=              # where voices and results are stored (default: temp folder)
